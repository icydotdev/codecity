{
  "name": "codecity",
  "version": "1.1.2",
  "description": "A map of your codebase, one building per file: what changed since you last looked, where your coding agents are working, and which files everything else depends on.",
  "type": "module",
  "bin": {
    "codecity": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Sam Kavanagh",
  "license": "MIT",
  "homepage": "https://codecity.icy.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icydotdev/codecity.git"
  },
  "keywords": [
    "codebase",
    "visualization",
    "code-city",
    "git",
    "3d",
    "threejs",
    "map",
    "dependencies",
    "imports",
    "developer-tools",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
